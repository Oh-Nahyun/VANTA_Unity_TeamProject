    },
    "m_SourceType": 1,
    "m_FunctionName": "Boss2SpriteFX",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 보스2 연출 후처리: 디졸브 테두리 발광, 낫 에너지 흐름, 오라 외곽선, 히트 플래시\nfloat3 col = Color.rgb;\nfloat a = Alpha;\n\n// 1. 디졸브 테두리를 HDR 로 키워 Bloom 이 걸리게 한다\ncol += Edge.rgb * max(EdgeIntensity - 1.0, 0.0);\n\n// 2. 낫 에너지 흐름: 픽셀 단위로 끊은 위치에서 흐르는 값 노이즈\nfloat3 pp = floor(Pos * 18.0) / 18.0;\nfloat tt = _TimeParameters.x * BladeFlowSpeed;\nfloat2 q = pp.xy * 5.0 + float2(tt * 0.7, -tt);\nfloat2 qi = floor(q);\nfloat2 qf = frac(q);\nqf = qf * qf * (3.0 - 2.0 * qf);\nfloat h00 = frac(sin(dot(qi, float2(12.9898, 78.233))) * 43758.5453);\nfloat h10 = frac(sin(dot(qi + float2(1, 0), float2(12.9898, 78.233))) * 43758.5453);\nfloat h01 = frac(sin(dot(qi + float2(0, 1), float2(12.9898, 78.233))) * 43758.5453);\nfloat h11 = frac(sin(dot(qi + float2(1, 1), float2(12.9898, 78.233))) * 43758.5453);\nfloat nz = lerp(lerp(h00, h10, qf.x), lerp(h01, h11, qf.x), qf.y);\nfloat flow = smoothstep(0.45, 0.85, nz);\ncol += BladeFlowColor.rgb * flow * BladeFlowAmount * saturate(BladeMask) * a;\n\n// 3. 오라 외곽선: 상하좌우 이웃 알파로 바깥 테두리를 만들고 맥동시킨다\nuint texW, texH;\nMainTex.tex.GetDimensions(texW, texH);\nfloat2 ts = float2(1.0 / max(texW, 1u), 1.0 / max(texH, 1u)) * max(OutlineWidth, 0.0);\nfloat own = SAMPLE_TEXTURE2D(MainTex.tex, MainTex.samplerstate, UV.xy).a;\nfloat nb = max(max(SAMPLE_TEXTURE2D(MainTex.tex, MainTex.samplerstate, UV.xy + float2(ts.x, 0)).a,\n                   SAMPLE_TEXTURE2D(MainTex.tex, MainTex.samplerstate, UV.xy - float2(ts.x, 0)).a),\n               max(SAMPLE_TEXTURE2D(MainTex.tex, MainTex.samplerstate, UV.xy + float2(0, ts.y)).a,\n                   SAMPLE_TEXTURE2D(MainTex.tex, MainTex.samplerstate, UV.xy - float2(0, ts.y)).a));\nfloat edgeMask = step(0.01, nb) * step(own, 0.01);\nfloat pulse = 0.75 + 0.25 * sin(_TimeParameters.x * OutlinePulseSpeed);\nfloat o = edgeMask * saturate(OutlineAmount) * (1.0 - saturate(DissolveAmount));\ncol = lerp(col, OutlineColor.rgb * pulse, o);\na = max(a, o);\n\n// 4. 히트 플래시: 보이는 픽셀만 지정 색으로\ncol = lerp(col, FlashColor.rgb, saturate(FlashAmount) * step(0.001, Alpha));\n\nOutColor = float4(col, 1.0);\nOutAlpha = a;"
}

