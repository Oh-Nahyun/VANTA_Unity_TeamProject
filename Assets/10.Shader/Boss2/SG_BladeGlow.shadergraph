{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9813de1930a04bdb86243ac156682ac7",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BloodTint (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -780.0,
            "y": -260.0,
            "width": 180.0,
            "height": 190.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "97097ba29bf74610a9b23e8ef2eef58e"
        },
        {
            "m_Id": "3ac7f37eac2e4c508a2c25046a96a15b"
        },
        {
            "m_Id": "ab47e0c6ab244d5dba3e6c5e76d3094c"
        },
        {
            "m_Id": "d103341756b2455ca37359ddff47fc13"
        },
        {
            "m_Id": "2fffee83cfae42ed9737a8743eccd22d"
        },
        {
            "m_Id": "ec9def021c49445a8af2a60615916fbf"
        },
        {
            "m_Id": "f25dbb5d886a4f5aad03e1c187579bb8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BloodTint",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// \uac80\uc758 \ubd84\ud64d \uacc4\uc5f4 \ud53d\uc140\uc744 \ud54f\ube5b\uc73c\ub85c \ubc14\uafbc\ub2e4. \uc6d0\ub798 \ubc1d\uae30 \ube44\uc728\uc744 \uc720\uc9c0\ud574 3\ud1a4 \uba85\uc554\uc774 \uc0b4\uc544 \uc788\ub2e4.\r\nfloat3 c = In.rgb;\r\nfloat d = distance(c, KeyColor.rgb);\r\nfloat key = saturate((KeyRange - d) / max(KeyFuzziness, 1e-5));\r\nfloat3 lumW = float3(0.2126, 0.7152, 0.0722);\r\nfloat lum = dot(c, lumW);\r\nfloat keyLum = max(dot(KeyColor.rgb, lumW), 1e-5);\r\nfloat3 blood = BloodColor.rgb * (lum / keyLum) * Brightness;\r\nOut = float4(lerp(c, blood, key), In.a);"
}

