{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a1cf15e4cddd42068f6d5f58fb31e5a6",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Boss2DissolveAmount (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -560.0,
            "y": 860.0,
