        }
    },
    "m_Slots": [
        {
            "m_Id": "69161fd8acd146e79734f131e53539ef"
        },
        {
            "m_Id": "26eb1ce529054c519e3560b23f9d0235"
        },
        {
            "m_Id": "23a8817b3d1a49d5aaa97c0633efd270"
        },
        {
            "m_Id": "e3799d3cdc404cbca95bf07321cb092d"
        },
        {
            "m_Id": "d773c1bdc2dd4a88b3782164b33f1af9"
        },
        {
            "m_Id": "662c98c519584b63b005ca1b2e819c6b"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Boss2DissolveAmount",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 위쪽 픽셀일수록 먼저 사라지게 픽셀별 디졸브 양을 만든다. Direction 0 이면 원래와 같다.\nfloat g = saturate((Pos.y - BottomY) / max(TopY - BottomY, 1e-4));\nEffAmount = saturate(Amount * (1.0 + Direction) - Direction * (1.0 - g));"
}

